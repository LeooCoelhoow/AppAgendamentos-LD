// ============================================================
// schema.prisma — Modelos do Banco de Dados
// ============================================================
//
// Define a estrutura das tabelas no PostgreSQL (Supabase).
// Modelos:
//   - User: Cadastro de clientes e administradores
//   - Service: Serviços oferecidos
//   - Appointment: Agendamentos de serviços
//   - WorkingHours: Horário de funcionamento (segunda-sábado)
//   - Expense: Despesas do administrador (relatório financeiro)
//
// Enums:
//   - Role: CLIENT (padrão) ou ADMIN
//   - Status: PENDING, CONFIRMED, COMPLETED, CANCELLED
//
// Para aplicar mudanças no banco:
//   npx prisma migrate dev --name <migration_name>
//
// Para gerar o Prisma Client:
//   npx prisma generate
// ============================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelo de Usuário — representa clientes e administradores
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  password  String // Hash bcrypt — NUNCA armazenar senha em texto plano
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relacionamento 1:N — um usuário pode ter vários agendamentos
  appointments Appointment[]

  /// Relacionamento 1:N — horário de funcionamento (segunda-sábado)
  workingHours WorkingHours[]
}

/// Modelo de Serviço — serviços de beleza oferecidos
model Service {
  id              String   @id @default(uuid())
  name            String // Nome do serviço (ex: "Brow Lamination")
  description     String // Descrição do serviço
  price           Float // Preço em reais
  durationMinutes Int      @default(60) // Duração em minutos
  icon            String // Emoji representativo (ex: "✨")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Relacionamento 1:N — serviço pode ter vários agendamentos
  appointments Appointment[]
}

/// Modelo de Agendamento — serviços agendados pelos clientes
model Appointment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  date            DateTime // Data do agendamento
  time            String // Horário (ex: "14:00")
  status          Status   @default(PENDING)
  price           Float // Valor do serviço em reais
  clientConfirmed Boolean  @default(false) // Confirmação da cliente
  adminConfirmed  Boolean  @default(false) // Confirmação do admin (finalizar atendimento)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Modelo de Horário de Funcionamento — segunda a sábado (sem domingo)
model WorkingHours {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Segunda, 1 = Terça, ..., 5 = Sábado (SEM domingo)
  startTime String // Horário início (ex: "09:00")
  endTime   String // Horário fim (ex: "18:00")
  isOpen    Boolean  @default(true) // Se está aberto neste dia
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek]) // Um usuário tem um horário por dia
}

/// Modelo de Despesa — gastos do administrador para o relatório financeiro
model Expense {
  id        String   @id @default(uuid())
  name      String // Nome/descrição da despesa (ex: "Aluguel do estúdio")
  value     Float // Valor da despesa em reais
  date      DateTime @default(now()) // Data da despesa
  createdAt DateTime @default(now())
}

/// Papel do usuário no sistema
enum Role {
  CLIENT // Cliente padrão
  ADMIN // Administrador (acesso ao painel ADM)
}

/// Status possíveis de um agendamento
enum Status {
  PENDING // Aguardando confirmação
  CONFIRMED // Confirmado pela administradora
  COMPLETED // Serviço realizado (ambas confirmações feitas)
  CANCELLED // Cancelado
}
